{
  "name": "@latent-music-terrarium/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync-data && vite",
    "build": "npm run sync-data && tsc --noEmit && vite build && npm run build:worker",
    "build:worker": "vite build --config vite.export.config.ts",
    "probe:worker": "npm run build:worker && node dist-worker/worker.mjs --probe",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "sync-data": "node scripts/sync-data.mjs",
    "build:publish": "node scripts/sync-data.mjs --publish && tsc --noEmit && vite build --mode demo"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/node": "22.20.1",
    "@webgpu/types": "^0.1.64",
    "typescript": "^5.9.2",
    "vite": "^7.1.1"
  },
  "dependencies": {
    "tweakpane": "^4.0.5",
    "webgpu": "0.4.0"
  }
}

node_modules/
dist/
.astro/
*.log
.env
.env.*
# ...except the one that carries no secret and that `build:publish` needs: it
# holds `VITE_DEMO=1` and nothing else, and without it a fresh clone silently
# builds the full app and calls it the demo cut.
!web/.env.demo
.DS_Store
Thumbs.db

# analysis pipeline
__pycache__/
*.pyc
.venv/
venv/

# large media / generated timelines
/media/
/analysis/out/
*.wav
*.mp3
*.flac

# regenerable large embeddings
data/**/embedding.bin
data/**/embedding.json

# local headless-export requests, decoded inspection frames, and video artifacts
/web/exports/
/web/.export-work/
/data/timelines/.work/

# rendered video output from the headless exporter — regenerable, and large
# (14 GB locally at the time this rule was added). /web/exports/ above covers
# the request JSON; this covers the frames and muxed video.
/data/exports/

# regenerable analysis caches, same rule as the embeddings above: the all-in-one
# structure model's activations and the spectrogram it is fed. Both are rebuilt
# from audio.wav by the pipeline, and the spectrogram alone is 20 MB per track.
data/**/allin1/
data/**/spec/
.claude/worktrees/
